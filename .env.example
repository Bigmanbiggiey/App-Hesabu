# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=hesabu.settings.development

# ── Production overrides ──────────────────────────────────────────────────────
# The server's real .env (not this file, never committed) should instead set:
#   DEBUG=False
#   ALLOWED_HOSTS=<your-domain>
#   CORS_ALLOWED_ORIGINS=https://<your-domain>
#   CSRF_TRUSTED_ORIGINS=https://<your-domain>
#   FRONTEND_URL=https://<your-domain>
#   DJANGO_SETTINGS_MODULE=hesabu.settings.production
#   DB_HOST=db                          (container DNS name, not localhost)
#   CELERY_BROKER_URL=redis://redis:6379/0
#   CELERY_RESULT_BACKEND=redis://redis:6379/0
#   ETIMS_BASE_URL=https://etims.kra.go.ke/etims-api
#   DARAJA_BASE_URL=https://api.safaricom.co.ke
#   DARAJA_CALLBACK_URL / DARAJA_STK_CALLBACK_URL pointed at the real domain
#   STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY switched to live (sk_live_/pk_live_) keys
#   CLOUDFLARE_TUNNEL_TOKEN=<token of the tunnel we own>   (docker-compose.prod.yml refuses to start without it)

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=hesabu
DB_USER=hesabu_user
DB_PASSWORD=hesabu_pass
DB_HOST=localhost
DB_PORT=5432

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── KRA eTIMS ─────────────────────────────────────────────────────────────────
# Sandbox: https://etims-sbx.kra.go.ke/etims-api
# Production: https://etims.kra.go.ke/etims-api
ETIMS_BASE_URL=https://etims-sbx.kra.go.ke/etims-api
ETIMS_PIN=A000000000B

# ── Safaricom Daraja (M-Pesa) ─────────────────────────────────────────────────
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/mpesa/callback/
# STK Push result callback (subscription billing)
DARAJA_STK_CALLBACK_URL=https://yourdomain.com/api/v1/billing/mpesa/callback/
# Source-IP allowlist for the two unauthenticated M-Pesa callbacks. Leave
# empty in dev/sandbox. In production set to Safaricom's published callback
# IPs (verify against current Daraja docs) and also enforce the same set at
# the edge (e.g. a Cloudflare WAF rule). Example:
# DARAJA_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69
DARAJA_ALLOWED_IPS=
# True when a reverse proxy fronts the app (production). Defaults True in
# hesabu.settings.production.
DARAJA_TRUST_FORWARDED_FOR=False

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── Web Push notifications (VAPID) ────────────────────────────────────────────
# Leave empty to disable push (the in-app notification list still works).
# Generate a pair straight into the env file, so the private key never shows:
#   docker compose -f docker-compose.prod.yml run --rm -T --no-deps backend \
#     python manage.py generate_vapid_keys >> .env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hesabu.co.ke

# ── Africa's Talking (SMS) ────────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=your-at-api-key
AT_SENDER_ID=HESABU

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@hesabu.co.ke
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Hesabu <noreply@hesabu.co.ke>

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5175
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
